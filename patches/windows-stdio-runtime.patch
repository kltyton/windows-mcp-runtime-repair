+use std::future::Future;
+use std::task::Context as TaskContext;
+use std::task::Waker;
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use codex_utils_pty::Command;
+use rmcp::transport::Transport;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::BufReader;
+
+use super::LocalStdioTransport;
+use crate::protocol_mode::McpProtocolMode;
+use crate::utils::create_env_for_mcp_server;
+
+#[test]
+fn idle_stdio_reads_leave_blocking_pool_available_for_config_io() -> Result<()> {
+    let server = codex_utils_cargo_bin::cargo_bin("test_stdio_server")?;
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(1)
+        .max_blocking_threads(2)
+        .enable_all()
+        .build()?;
+
+    runtime.block_on(async {
+        for protocol in [McpProtocolMode::Legacy, McpProtocolMode::V20260728] {
+            let program = server.clone();
+            let env = create_env_for_mcp_server(None, &[])?;
+            let (mut transport, stderr) = tokio::task::spawn_blocking(move || {
+                let mut command = Command::new(program);
+                command.envs(&env);
+                LocalStdioTransport::spawn(command, "test_stdio_server".to_owned(), protocol)
+            })
+            .await??;
+            let mut stderr = BufReader::new(stderr.context("test server stderr was not piped")?);
+            let result: Result<()> = async {
+                let mut startup = String::new();
+                let received =
+                    tokio::time::timeout(Duration::from_secs(10), stderr.read_line(&mut startup))
+                        .await??;
+                ensure!(
+                    received > 0,
+                    "test server exited before its startup diagnostic"
+                );
+
+                // Poll both idle reads before enqueueing filesystem work. With
+                // blocking pipes these two reads occupy this runtime's entire pool.
+                let stdout_read = transport.receive();
+                tokio::pin!(stdout_read);
+                let mut context = TaskContext::from_waker(Waker::noop());
+                ensure!(stdout_read.as_mut().poll(&mut context).is_pending());
+                let mut byte = [0];
+                let stderr_read = stderr.read(&mut byte);
+                tokio::pin!(stderr_read);
+                ensure!(stderr_read.as_mut().poll(&mut context).is_pending());
+                tokio::time::timeout(Duration::from_secs(10), tokio::fs::metadata(&server))
+                    .await
+                    .context("idle MCP pipes exhausted the configuration I/O pool")??;
+                Ok(())
+            }
+            .await;
+
+            // Always release the fixture, including when the regression times out.
+            transport.close().await?;
+            result?;
+        }
+        Ok(())
+    })
+}
